  </head>
  <body>
    <header>
      <div class='title'>
        <h1>Invoice Erasmus Generation Meeting 2026</h1>
      </div>
    </header>

    <h3>{{name}}</h3>

    <div class='invoice-details'>
      <div class='left-section'>
        <p><strong>Reference:</strong> {{reference}}</p>
        <p><strong>Date of issue:</strong> {{issueDate}}</p>
        <p><strong>Invoice due date:</strong> {{dueDate}}</p>
      </div>
      <div class='right-section'>
        <p>{{invoiceAddress}}</p>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Item Description</th>
          <th>Item Price</th>
          <th>#</th>
          <th>Price</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>{{spotType}} spot Erasmus Generation Meeting Split 2026</td>
          <td>{{spotPrice}}</td>
          <td>1</td>
          <td>{{spotPrice}}</td>
        </tr>
      </tbody>
    </table>

    <div class='total-amount'>
      <p><strong>Total amount to pay:</strong> {{spotPrice}}</p>
    </div>

    <p>The participant is hereby invited to attend the Erasmus Generation Meeting Split 2026 and pay the participation
      fee until the
      {{dueDate}}.</p>

    <ul>
      <li><strong>Beneficiary:</strong> Erasmus studentska mreža Split</li>
      <li><strong>Beneficiary address:</strong> Ruđera Boškovića 31, 21000 Split, Croatia</li>
      <li><strong>Bank name:</strong> OTP banka</li>
      <li><strong>Bank address:</strong> Domovinskog rata 61, 21000 Split, Croatia</li>
      <li><strong>IBAN:</strong> HR4524070001100427189</li>
      <li><strong>SWIFT CODE:</strong> OTPVHR2X</li>
    </ul>

    <p class='reference-number'>Please write the reference number of your invoice on the payment.</p>
    <p class='payment-details'>Your Reference: {{reference}}</p>
    <p class='reason-for-payment'>Reason for payment:
      {{name}}
      -
      {{reference}}
      - Erasmus Generation Meeting Split 2026</p>
    <p class='fee-info'>Be sure to cover all the fees; otherwise, you will be asked to pay the missing part upon
      arrival.</p>

    <footer>
      ESN AISBL | Rue Joseph II 120 1000 Brussels Belgium | www.esn.org
    </footer>
